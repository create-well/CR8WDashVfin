# Copy to a server-only environment configuration; never commit a populated copy.
# Required for the Notion adapter.
NOTION_API_KEY=

# Optional: override only for local mock tests or a controlled proxy.
NOTION_API_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11

# Required only when the worker has an approved Supabase write path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keep schema mutation disabled unless the written proposal is approved.
NOTION_SCHEMA_CHANGE_APPROVED=false

# Optional worker controls.
NOTION_SYNC_SOURCE=
NOTION_SYNC_LIMIT=100
