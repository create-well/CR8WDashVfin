  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "validate:vercel-env": "node scripts/validate-vercel-env.mjs",
    "test": "vitest run",
    "test:node": "node --test tests/*.test.mjs",
    "test:ts": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:contract": "node --test tests/notion-contract.test.ts",
    "test:atomic-rpc": "node --test tests/verify-atomic-rpc-payload.test.mjs",
    "test:rollback": "node --test tests/verify-v2-rollback-backup.test.mjs",
    "test:rollback:integration": "node --test tests/v2-rollback-mitigation.integration.test.mjs",
    "test:production": "node tests/production-dashboard-integration.mjs",
    "verify:backup": "node --experimental-strip-types tools/rollback-gate/cli.ts",
    "rollback:verify": "node scripts/rollback-operator-guard.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:node && npm run test:ts && npm run typecheck && npm run build"
  },
